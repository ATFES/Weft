TARGET_NAME=v100
SSH_ALIAS=rvv-v100

WEFT_ROOT=/home/zhy001/Weft
WEFT_BRANCH=v100-jit
WEFT_BUILD_DIR=/home/zhy001/Weft/build-v100
WEFT_COMPILER=/home/zhy001/Weft/build-v100/tools/weft-compile/weft-compile

LLVM_PREFIX=/usr/local/llvm-22.1.8
WEFT_CC=/usr/local/llvm-22.1.8/bin/clang

WEFT_GGML_LIB_DIR=/home/zhy001/rvv-v100-llama/build-v100-clang18-gomp/bin
WEFT_GGML_SOURCE_DIR=/home/zhy001/rvv-v100-llama

WEFT_CPU=3
WEFT_CFLAGS="-fno-integrated-as -B/usr/lib/gcc/riscv64-openEuler-linux/14 -L/usr/lib/gcc/riscv64-openEuler-linux/14"

WEFT_PYTHONPATH=/home/zhy001/Weft/python:/home/zhy001/Weft/examples
WEFT_RESULT_ROOT=/tmp/weft-native-jit
